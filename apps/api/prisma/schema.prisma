// Americana Earn data model. See docs/SPEC.md section 6.
// Rules:
// - All money amounts are BIGINT integer cents; rates are bps (10000 = 100%).
// - Tenant-scoped tablolarda tenant_id + index.
// - ledger_entries SILINMEZ; guncellenen tek alanlar status/payout_id.
// - memberships.path is ltree-compatible TEXT (UUIDs use underscores); placement is immutable.
//   The ltree extension is enabled by migration (docs/DECISIONS.md).

generator client {
  provider = "prisma-client-js"
  // native = local development (Windows); debian-openssl-3.0.x = Docker runtime (bookworm)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  platform_admin
  tenant_owner
  tenant_admin
  tenant_staff
  member
}

enum TenantStatus {
  active
  suspended
}

enum MembershipStatus {
  active
  inactive
}

enum InviteStatus {
  active
  used
  expired
  revoked
}

enum MaturationRule {
  on_approval
  on_delivery
  days_after_approval
}

enum SaleStatus {
  draft
  approved
  void
}

enum LedgerType {
  commission
  reversal
  adjustment
}

enum LedgerStatus {
  pending
  payable
  processing
  paid
  reversed
}

enum PayoutMethod {
  manual
  csv
  stripe
}

enum PayoutStatus {
  requested
  processing
  paid
  rejected
  failed
}

enum PayoutSettlementBatchStatus {
  processing
  settled
  failed
}

enum PayoutReadinessCheckKey {
  address
  kyc
  fraud
  sanctions
  payment_method
}

enum PayoutReadinessDecisionStatus {
  pending
  ready
  blocked
}

enum NotificationChannel {
  push
  email
  in_app
}

enum NotificationStatus {
  pending
  processing
  sent
  failed
}

model Tenant {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                String         @unique
  name                String
  currency            String         @default("USD")
  timezone            String         @default("America/New_York")
  maturationRule      MaturationRule @default(on_delivery) @map("maturation_rule")
  maturationDays      Int?           @map("maturation_days")
  payoutMinCents      BigInt         @default(100000) @map("payout_min_cents")
  compressionEnabled  Boolean        @default(false) @map("compression_enabled")
  inactiveMembersEarn Boolean        @default(true) @map("inactive_members_earn")
  notifyNewMemberName Boolean        @default(true) @map("notify_new_member_name")
  // Separation of duties (maker-checker): the sale creator cannot approve it.
  // Default is off so single-admin tenants keep working; self-approval is still audited.
  requireSeparateApprover Boolean    @default(false) @map("require_separate_approver")
  branding            Json           @default("{}")
  status              TenantStatus   @default(active)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  memberships Membership[]
  invites     Invite[]
  inviteAcceptanceConsents InviteAcceptanceConsent[]
  plans       CommissionPlan[]
  sales       Sale[]
  ledger      LedgerEntry[]
  summaries   MonthlySummary[]
  teamStats   TeamStat[]
  payouts     Payout[]
  payoutBatches PayoutBatch[]
  roles       TenantRole[]
  bulkActionExecutions BulkActionExecution[]

  @@map("tenants")
}

// RBAC: tenant-scoped roles. System roles (isSystem) cannot be deleted or renamed;
// custom roles can be edited. permissions = permission-key array from common/permissions.ts.
// tenant_owner always carries all permissions at the enum layer, independent of roleId.
model TenantRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String
  name        String
  description String?
  color       String?
  isSystem    Boolean  @default(false) @map("is_system")
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  avatarPath      String?   @map("avatar_path")
  locale          String    @default("en")
  emailVerifiedAt DateTime? @map("email_verified_at")
  // Platform owner (Axtra): cross-tenant; manages companies and does not require membership.
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  // 2FA: TOTP secret is written during setup and verified when enabled.
  totpSecret      String?   @map("totp_secret")
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  // One-time recovery codes; only SHA-256 hashes are stored.
  mfaRecoveryCodes Json?    @map("mfa_recovery_codes")
  // "Remember last choice" (SPEC 4.1): active tenant selection for multi-membership users.
  lastMembershipId String?  @map("last_membership_id") @db.Uuid
  // Incremented whenever active credentials must be invalidated. Legacy JWTs and refresh rows lack this value.
  authGeneration  Int       @default(1) @map("auth_generation")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships   Membership[]
  devices       Device[]
  refreshTokens RefreshToken[]
  userTokens    UserToken[]
  pendingInviteAcceptances PendingInviteAcceptance[]
  inviteAcceptanceConsents InviteAcceptanceConsent[]
  bulkActionExecutions BulkActionExecution[]

  @@map("users")
}

// Rotating refresh token (SPEC 5): only SHA-256 hashes are stored in the DB.
// Reuse detection revokes all user tokens if a revoked token is presented.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  // Nullable so sessions issued before MFA session assurance are never trusted as MFA-complete.
  mfaVerifiedAt DateTime? @map("mfa_verified_at")
  // Nullable so rows issued before session generation enforcement fail closed.
  authGeneration Int?      @map("auth_generation")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum UserTokenPurpose {
  email_verify
  password_reset
  login_otp
}

// Email verification and password reset tokens (one-time, hashed).
model UserToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingInviteAcceptance PendingInviteAcceptance?

  @@index([userId, purpose])
  // Required as the referenced key for pending invite challenge ownership.
  @@unique([userId, id], map: "user_tokens_user_id_id_key")
  @@map("user_tokens")
}

model Membership {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  userId              String           @map("user_id") @db.Uuid
  // Coarse authorization layer (auth/scope): platform/tenant split and owner god-mode depend on this enum.
  role                Role             @default(member)
  // Fine-grained authorization: assigned custom role. Defaults come from the enum layer when absent.
  roleId              String?          @map("role_id") @db.Uuid
  sponsorMembershipId String?          @map("sponsor_membership_id") @db.Uuid
  referralCode        String           @map("referral_code")
  // ltree-compatible materialized path: parent.path || own_id (UUIDs use underscores). Immutable.
  path                String
  depth               Int
  status              MembershipStatus @default(active)
  // Channel-based notification preferences: { "<event>": { in_app, email, push } }. Empty means defaults.
  notificationPrefs   Json             @default("{}") @map("notification_prefs")
  joinedAt            DateTime         @default(now()) @map("joined_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  roleRef  TenantRole?  @relation(fields: [roleId], references: [id])
  sponsor  Membership?  @relation("SponsorTree", fields: [sponsorMembershipId], references: [id])
  children Membership[] @relation("SponsorTree")

  invitesSent Invite[]         @relation("Inviter")
  sales       Sale[]           @relation("Seller")
  ledger      LedgerEntry[]    @relation("Beneficiary")
  summaries   MonthlySummary[]
  teamStats   TeamStat[]
  payouts     Payout[]
  inviteAcceptanceConsents InviteAcceptanceConsent[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id], map: "memberships_tenant_id_id_uidx")
  @@unique([tenantId, referralCode])
  @@index([tenantId, sponsorMembershipId])
  @@index([tenantId, path])
  @@map("memberships")
}

model Invite {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String       @map("tenant_id") @db.Uuid
  inviterMembershipId String       @map("inviter_membership_id") @db.Uuid
  code                String       @unique
  email               String?
  expiresAt           DateTime     @map("expires_at")
  usedByMembershipId  String?      @map("used_by_membership_id") @db.Uuid
  idempotencyKeyHash  String?      @map("idempotency_key_hash")
  status              InviteStatus @default(active)
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  inviter Membership @relation("Inviter", fields: [inviterMembershipId], references: [id])
  pendingAcceptances PendingInviteAcceptance[]
  inviteAcceptanceConsents InviteAcceptanceConsent[]

  @@index([tenantId, status])
  @@unique([inviterMembershipId, idempotencyKeyHash], map: "invites_inviter_idempotency_key_hash_uidx")
  @@map("invites")
}

// Existing MFA users stage invite acceptance here until the linked one-time MFA challenge succeeds.
model PendingInviteAcceptance {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  inviteId                  String    @map("invite_id") @db.Uuid
  challengeTokenId          String    @unique @map("challenge_token_id") @db.Uuid
  tenantId                  String?   @map("tenant_id") @db.Uuid
  disclaimerVersion         String?   @map("disclaimer_version")
  disclaimerLocale          String?   @map("disclaimer_locale")
  disclaimerContentHash     String?   @map("disclaimer_content_hash")
  tenantDisplayName         String?   @map("tenant_display_name")
  programSummary            String?   @map("program_summary")
  programSummaryHash        String?   @map("program_summary_hash")
  consentAcceptedAt         DateTime? @map("consent_accepted_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  completedAt               DateTime? @map("completed_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite     Invite    @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  challenge  UserToken @relation(fields: [userId, challengeTokenId], references: [userId, id], onDelete: Cascade)

  @@index([userId, inviteId])
  @@unique([userId, challengeTokenId], map: "pending_invite_acceptances_user_challenge_token_key")
  @@map("pending_invite_acceptances")
}

model InviteAcceptanceConsent {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviteId              String   @map("invite_id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  membershipId          String   @map("membership_id") @db.Uuid
  disclaimerVersion     String   @map("disclaimer_version")
  locale                 String
  disclaimerContentHash String   @map("disclaimer_content_hash")
  tenantDisplayName     String   @map("tenant_display_name")
  programSummary        String   @map("program_summary")
  programSummaryHash    String   @map("program_summary_hash")
  acceptedAt            DateTime @default(now()) @map("accepted_at")
  createdAt             DateTime @default(now()) @map("created_at")

  invite     Invite     @relation(fields: [inviteId], references: [id], onDelete: Restrict)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@unique([inviteId, userId])
  @@index([tenantId, acceptedAt])
  @@map("invite_acceptance_consents")
}

model CommissionPlan {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  poolRateBps   Int      @map("pool_rate_bps")
  depth         Int
  effectiveFrom DateTime @map("effective_from")
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant                @relation(fields: [tenantId], references: [id])
  levels CommissionPlanLevel[]

  // Historical query: active plan on sale date (effective_from <= sale_date, newest first).
  @@index([tenantId, effectiveFrom(sort: Desc)])
  @@map("commission_plans")
}

model CommissionPlanLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  level     Int
  rateBps   Int      @map("rate_bps")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // SUM(rate_bps) <= pool_rate_bps is enforced by a constraint trigger in the migration.
  @@unique([planId, level])
  @@map("commission_plan_levels")
}

model Sale {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  sellerMembershipId String     @map("seller_membership_id") @db.Uuid
  amountCents        BigInt     @map("amount_cents")
  currency           String     @default("USD")
  customerRef        String?    @map("customer_ref")
  createdBy          String?    @map("created_by") @db.Uuid
  saleDate           DateTime   @map("sale_date")
  // monthly_summaries month key is frozen on first apply. Later tenant.timezone changes
  // do not move credits/debits into a different bucket; see DECISIONS review findings.
  summaryMonth       String?    @map("summary_month")
  status             SaleStatus @default(draft)
  approvedBy         String?    @map("approved_by") @db.Uuid
  approvedAt         DateTime?  @map("approved_at")
  deliveredAt        DateTime?  @map("delivered_at")
  externalRef        String?    @map("external_ref")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  seller Membership    @relation("Seller", fields: [sellerMembershipId], references: [id])
  ledger LedgerEntry[]

  @@index([tenantId, status])
  @@index([tenantId, saleDate])
  @@unique([tenantId, externalRef], map: "sales_tenant_external_ref_uidx")
  @@map("sales")
}

model BulkActionExecution {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  actorUserId        String   @map("actor_user_id") @db.Uuid
  idempotencyKeyHash String   @map("idempotency_key_hash")
  requestHash        String   @map("request_hash")
  status             String
  response           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, actorUserId, idempotencyKeyHash], map: "bulk_action_exec_tenant_actor_key_uidx")
  @@map("bulk_action_executions")
}

model LedgerEntry {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String       @map("tenant_id") @db.Uuid
  saleId                  String       @map("sale_id") @db.Uuid
  beneficiaryMembershipId String       @map("beneficiary_membership_id") @db.Uuid
  level                   Int
  rateBpsUsed             Int          @map("rate_bps_used")
  amountCents             BigInt       @map("amount_cents")
  type                    LedgerType
  status                  LedgerStatus
  maturesAt               DateTime?    @map("matures_at")
  payoutId                String?      @map("payout_id") @db.Uuid
  payoutBatchId           String?      @map("payout_batch_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  sale        Sale       @relation(fields: [saleId], references: [id])
  beneficiary Membership @relation("Beneficiary", fields: [beneficiaryMembershipId], references: [id])
  // Restrict prevents a deleted payout from silently nulling payout_id on paid rows.
  // This protects ledger immutability; see DECISIONS review findings.
  payout      Payout?    @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payoutBatch PayoutBatch? @relation("CurrentPayoutBatch", fields: [payoutBatchId], references: [id], onDelete: Restrict)
  batchItems  PayoutBatchItem[]

  // Double payment is impossible: rerunning the engine yields the same result.
  @@unique([saleId, level, type])
  @@index([tenantId, beneficiaryMembershipId, status])
  @@index([status, maturesAt])
  @@index([payoutBatchId, status])
  @@map("ledger_entries")
}

model MonthlySummary {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  // YYYY-MM according to tenant timezone (SPEC 10, Time).
  month        String
  level        Int
  pendingCents BigInt   @default(0) @map("pending_cents")
  payableCents BigInt   @default(0) @map("payable_cents")
  processingCents BigInt @default(0) @map("processing_cents")
  paidCents    BigInt   @default(0) @map("paid_cents")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, membershipId, month, level])
  @@index([tenantId, month])
  @@map("monthly_summaries")
}

model TeamStat {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  level        Int
  memberCount  Int      @default(0) @map("member_count")
  activeCount  Int      @default(0) @map("active_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([tenantId, membershipId, level])
  @@map("team_stats")
}

model Payout {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  batchId      String?      @map("batch_id") @db.Uuid
  totalCents   BigInt       @map("total_cents")
  method       PayoutMethod @default(manual)
  status       PayoutStatus @default(requested)
  // Period: YYYY-MM (monthly, docs/DECISIONS.md).
  period       String
  // Active requested/processing rows receive this key; historical rows remain null.
  activeKey    String?      @map("active_key")
  processingStartedAt DateTime? @map("processing_started_at")
  processingByUserId String? @map("processing_by_user_id") @db.Uuid
  paidAt       DateTime?    @map("paid_at")
  settledAt    DateTime?    @map("settled_at")
  settledByUserId String?   @map("settled_by_user_id") @db.Uuid
  settlementReference String? @map("settlement_reference")
  settlementEvidence String? @map("settlement_evidence")
  recipientReferralCode String? @map("recipient_referral_code")
  recipientFullName String? @map("recipient_full_name")
  recipientEmail String? @map("recipient_email")
  complianceSnapshot Json? @map("compliance_snapshot")
  rejectedAt  DateTime?     @map("rejected_at")
  rejectedByUserId String?  @map("rejected_by_user_id") @db.Uuid
  rejectionReason String?   @map("rejection_reason")
  failedAt    DateTime?     @map("failed_at")
  failedByUserId String?    @map("failed_by_user_id") @db.Uuid
  failureReason String?     @map("failure_reason")
  ref          String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  membership Membership    @relation(fields: [membershipId], references: [id])
  batch      PayoutBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  entries    LedgerEntry[]
  batchItems PayoutBatchItem[]

  @@index([tenantId, status])
  @@index([batchId, status])
  @@map("payouts")
}

model PayoutReadinessCheck {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                         @map("tenant_id") @db.Uuid
  membershipId     String                         @map("membership_id") @db.Uuid
  key              PayoutReadinessCheckKey
  status           PayoutReadinessDecisionStatus  @default(pending)
  reasonCode       String                         @map("reason_code")
  reviewedByUserId String?                        @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                      @map("reviewed_at")
  expiresAt        DateTime?                      @map("expires_at")
  version          Int                            @default(1)
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")

  @@unique([tenantId, membershipId, key], map: "payout_readiness_checks_tenant_membership_key_uidx")
  @@index([tenantId, status, expiresAt], map: "payout_readiness_checks_tenant_status_expiry_idx")
  @@map("payout_readiness_checks")
}

model PayoutDestination {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  membershipId      String    @map("membership_id") @db.Uuid
  providerReference String    @map("provider_reference")
  maskedLabel       String    @map("masked_label")
  last4             String?   @map("last4")
  country           String
  currency          String
  verifiedByUserId  String?   @map("verified_by_user_id") @db.Uuid
  verifiedAt        DateTime? @map("verified_at")
  version           Int       @default(1)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, membershipId, active], map: "payout_destinations_tenant_membership_active_idx")
  @@map("payout_destinations")
}

// Processing batch and immutable row snapshots used to prove a later settlement or release.
model PayoutBatch {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  period              String
  method              PayoutMethod
  status              PayoutSettlementBatchStatus @default(processing)
  csvChecksum         String?           @map("csv_checksum")
  processingStartedAt DateTime          @default(now()) @map("processing_started_at")
  processingByUserId  String?           @map("processing_by_user_id") @db.Uuid
  settledAt           DateTime?         @map("settled_at")
  settledByUserId     String?           @map("settled_by_user_id") @db.Uuid
  settlementReference String?           @map("settlement_reference")
  settlementEvidence  String?           @map("settlement_evidence")
  failedAt            DateTime?         @map("failed_at")
  failedByUserId      String?           @map("failed_by_user_id") @db.Uuid
  failureReason       String?           @map("failure_reason")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  payouts Payout[]
  entries LedgerEntry[]      @relation("CurrentPayoutBatch")
  items   PayoutBatchItem[]

  @@index([tenantId, status, processingStartedAt])
  @@map("payout_settlement_batches")
}

model PayoutBatchItem {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId       String       @map("batch_id") @db.Uuid
  payoutId      String       @map("payout_id") @db.Uuid
  ledgerEntryId String       @map("ledger_entry_id") @db.Uuid
  membershipId  String       @map("membership_id") @db.Uuid
  month         String
  level         Int
  amountCents   BigInt       @map("amount_cents")
  recipientReferralCode String? @map("recipient_referral_code")
  recipientFullName     String? @map("recipient_full_name")
  recipientEmail        String? @map("recipient_email")
  recipientSnapshotAt   DateTime? @map("recipient_snapshot_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  batch       PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  payout      Payout      @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  ledgerEntry LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@unique([batchId, ledgerEntryId])
  @@index([payoutId])
  @@index([ledgerEntryId])
  @@map("payout_settlement_batch_items")
}

model Device {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  expoPushToken String   @unique @map("expo_push_token")
  platform      String
  lastSeenAt    DateTime @default(now()) @map("last_seen_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

// Outbox (SPEC 5): written inside the transaction; BullMQ worker sends asynchronously.
model Notification {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String?             @map("tenant_id") @db.Uuid
  recipientMembershipId String              @map("recipient_membership_id") @db.Uuid
  channel               NotificationChannel
  template              String
  payload               Json                @default("{}")
  status                NotificationStatus  @default(pending)
  attempts              Int                 @default(0)
  availableAt           DateTime?           @default(now()) @map("available_at")
  leaseToken            String?             @db.Uuid @map("lease_token")
  lastError             String?             @map("last_error")
  sentAt                DateTime?           @map("sent_at")
  // in_app channel: inbox read state; other channels remain null.
  readAt                DateTime?           @map("read_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([status, availableAt, createdAt], map: "notifications_status_available_created_idx")
  @@index([recipientMembershipId, channel, readAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
