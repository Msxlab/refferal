DATABASE_URL=postgresql://refearn:refearn@localhost:5434/refearn
DATABASE_URL_TEST=postgresql://refearn:refearn@localhost:5434/refearn_test
REDIS_URL=redis://localhost:6380
# Port 3001 is often used by another local project; the API uses 3101 for local development.
PORT=3101
CORS_ORIGINS=http://localhost:3000
# Required in production. Generate a strong random value.
JWT_ACCESS_SECRET=dev-local-access-secret-change-in-prod
# Optional rate-limit settings. Defaults: 120 requests / 60s; auth endpoints: 10 / 60s.
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120
