# Americana Earn reverse proxy. The site address comes from DOMAIN (compose passes ":80").
# When a real domain is provided, Caddy enables automatic TLS with Let's Encrypt.
{$DOMAIN::80} {
	# compose passes DOMAIN as ":80" or a domain name; ":80" means plain local HTTP.
	encode gzip zstd

	# Security headers for clickjacking, MIME sniffing, XSS surface, and HSTS.
	# HSTS only matters on real HTTPS; browsers ignore it in local ":80" mode.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API routes, readiness, and token-protected metrics go to NestJS.
	handle /v1/* {
		reverse_proxy api:3001
	}
	handle /healthz {
		reverse_proxy api:3001
	}
	handle /metrics {
		reverse_proxy api:3001
	}

	# Everything else goes to the Next.js web app.
	handle {
		reverse_proxy web:3000
	}
}
