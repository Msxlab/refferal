# ============================================================================
# Local development (run API/web with pnpm). Copy: cp .env.example .env
# ============================================================================
# Postgres/Redis - host ports 5434/6380 (see docker-compose.yml)
DATABASE_URL=postgresql://refearn:refearn@localhost:5434/refearn
DATABASE_URL_TEST=postgresql://refearn:refearn@localhost:5434/refearn_test
REDIS_URL=redis://localhost:6380

# Auth - use a strong random value in production. The app will not boot without it.
JWT_ACCESS_SECRET=change-me-access

POSTGRES_USER=refearn
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=refearn

# ============================================================================
# Full stack (docker compose --profile app up). Required only for production compose.
# ============================================================================
# Caddy domain. Empty/":80" means local HTTP. A real domain enables automatic HTTPS.
#   DOMAIN=earn.example.com
DOMAIN=
# Public root URL for API CORS and email links, usually https://DOMAIN.
PUBLIC_ORIGIN=http://localhost
APP_NAME=Americana Earn
APP_MONOGRAM=A
NEXT_PUBLIC_APP_NAME=${APP_NAME}
NEXT_PUBLIC_APP_MONOGRAM=${APP_MONOGRAM}
# Any non-empty invalid value, for example "none", disables required 2FA. Re-enable after bootstrap.
MFA_REQUIRED_ROLES=tenant_owner,tenant_admin,platform_admin

# SMTP. Leave empty in development to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Americana Earn <no-reply@americana-earn.local>

# Backup (local)
BACKUP_PREFIX=americana_earn
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP=3
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_MINUTES=1800

# --- Offsite: Google Drive (rclone + service account) ---
# 1) Google Cloud > Drive API > Service Account > download JSON key
#    -> place it at docker/backup/secrets/gdrive.json (do not commit it)
# 2) Create a Drive folder, share it with the service account email, and paste the folder ID here.
GDRIVE_FOLDER_ID=
# 3) Enable the offsite command. Leave empty for local-only backups.
#    BACKUP_OFFSITE_CMD=rclone copyto "$1" gdrive:$(basename "$1")
BACKUP_OFFSITE_CMD=
# Optional remote retention cleanup:
#    BACKUP_OFFSITE_RETENTION_CMD=rclone delete gdrive: --include "${BACKUP_PREFIX:-americana_earn}_*.sql.gz*" --min-age 30d --drive-use-trash=false
BACKUP_OFFSITE_RETENTION_CMD=
# Backup encryption (recommended): age public key. Generate with: age-keygen -o age.key
#    Keep the private key outside the server, for example in 1Password/Bitwarden and offline storage.
BACKUP_AGE_RECIPIENT=
# Optional alert command on backup failure; $1 = message.
#   BACKUP_ALERT_CMD=curl -fsS -m10 --retry 3 https://hc-ping.com/<uuid>/fail -d "$1"
BACKUP_ALERT_CMD=
